[kube_control_plane]
master-node1 ansible_host=${master-node_internal_ip}
# master-node2 ansible_host=95.54.0.13  # ip=10.3.0.2 etcd_member_name=etcd2

[etcd:children]
kube_control_plane

[kube_node]
%{ for i, ip in node_internal_ip ~}
node-${i + 1} ansible_host=${ip}
%{ endfor ~}

[all:vars]
ansible_user=ubuntu
ansible_become=yes